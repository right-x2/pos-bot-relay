# SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_TRUST_CERT=yes

# Chroma
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=pos_faq
IMAGE_RAG_MAX_DISTANCE=0.65
IMAGE_RAG_FALLBACK_MAX_DISTANCE=0.75
IMAGE_RAG_MIN_DISTANCE_GAP=0.15
IMAGE_RAG_CANDIDATE_COUNT=12
# Optional. Defaults to a SQLite file next to CHROMA_DIR.
CHROMA_TOMBSTONE_DB=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Internal tool API
MCP_BASE_URL=
MCP_API_KEY=
MCP_TIMEOUT_SEC=10
